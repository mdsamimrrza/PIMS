PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/pims?retryWrites=true&w=majority&appName=pims
CLIENT_URL=http://localhost:5173, https://pims-sys.vercel.app, https://pism-mnprjy5sp-rezas-projects-f4562f6a.vercel.app
SESSION_SECRET=replace_with_a_long_random_session_secret
SESSION_COOKIE_NAME=pims.sid
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_MS=604800000
ENABLE_ADMIN_SETUP=false
ADMIN_SETUP_TOKEN=replace_with_a_long_random_admin_setup_token
TRUST_PROXY=
BOOTSTRAP_DEMO_USERS=false
EMAIL_MODE=file
EMAIL_OUTBOX_DIR=outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=PIMS <your-gmail-address@gmail.com>
PHARMACY_NOTIFICATION_EMAIL=pharmacy@pims.local
ENABLE_BACKGROUND_JOBS=true
LOW_STOCK_JOB_INTERVAL_MS=21600000
EXPIRY_JOB_INTERVAL_MS=86400000
